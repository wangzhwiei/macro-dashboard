    {
      "id": "metro_composite",
      "category": "consumption",
      "family": "市内出行",
      "name": "重点城市地铁客流指数",
      "frequency": "daily",
      "unit": "指数",
      "source": "CJHX",
      "series": [
        {"code": "CJHX:METRO_SHANGHAI", "weight": 1},
        {"code": "CJHX:METRO_GUANGZHOU", "weight": 1}
      ],
      "aggregate": "standardized_mean",
      "component_preprocess": "rolling_7d_mean",
      "methodology": {
        "title": "城市客流7日均值标准化等权合成",
        "formula": "Metro_t = 100 + 10 × [z(MA7(上海)_t) + z(MA7(广州)_t)] ÷ 2",
        "calibration": "各城市分别使用当前数据文件覆盖的历史区间计算均值和标准差；每日更新时同一窗口重估。",
        "steps": [
          "分别提取上海、广州地铁每日客运量，按日期去重并剔除非数值记录。",
          "每个城市先计算自然日滚动7日均值，降低周内工作日结构和节假日错位噪声。",
          "对每个城市的7日均值分别做 z 标准化：z=(x-历史均值)÷历史标准差。",
          "按日期对齐两城数据；短暂缺数可沿用最近值，但最多允许向前填充10天。",
          "两城 z 值等权平均后映射为基准100、1个标准差等于10点的综合指数。"
        ]
      },
      "transform": "pct_change",
      "bond_direction": -1,
      "core": true,
      "weight": 1
    },
