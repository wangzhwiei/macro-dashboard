# mock: 使用内置可重复示例数据；http: 调用通用HTTP接口；custom: 调用自定义适配器
MACRO_DATA_ADAPTER=mock

# 通用HTTP接口配置。脚本会按 code/start_date/end_date/frequency 发送GET请求。
MACRO_API_URL=https://your-api.example.com/timeseries
MACRO_API_METHOD=GET
MACRO_API_KEY=
MACRO_API_AUTH_HEADER=Authorization
MACRO_API_AUTH_PREFIX=Bearer
MACRO_API_HEADERS_JSON=
MACRO_API_CODE_PARAM=code
MACRO_API_START_PARAM=start_date
MACRO_API_END_PARAM=end_date
MACRO_API_FREQUENCY_PARAM=frequency
MACRO_API_DATA_PATH=
MACRO_API_DATE_FIELD=date
MACRO_API_VALUE_FIELD=value

# 可选：将面板语义代码映射为供应商真实代码。未配置的代码保持原值。
# 先复制 config/provider-code-map.example.json 再填入真实代码。
# MACRO_API_CODE_MAP=config/provider-code-map.json

# 可选：只有你希望每天运行后自动提交 dashboard.json 时才设置。
GIT_USER_NAME=macro-dashboard-bot
GIT_USER_EMAIL=macro-dashboard@example.com
